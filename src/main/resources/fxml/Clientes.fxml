<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="root" stylesheets="@../Style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ecommerce.Controller.ClientesController">
   <ImageView fitHeight="400.0" fitWidth="600.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@../Images/1000095382.jpg" />
      </image>
   </ImageView>
    <AnchorPane prefHeight="400" prefWidth="600">
        <Label layoutX="24.0" layoutY="100.0" text="NOME" textFill="WHITE">
            <font>
                <Font name="PricedownBl-Regular" size="18" />
            </font>
        </Label>
        <TextField layoutX="112.0" layoutY="100.0" prefHeight="24.0" prefWidth="149.0" promptText="Digite o Nome do Cliente">
            <font>
                <Font name="PricedownBl-Regular" size="12" />
            </font>
        </TextField>
        <Label layoutX="30.0" layoutY="145.0" text="CPF" textFill="WHITE">
            <font>
                <Font name="PricedownBl-Regular" size="18" />
            </font>
        </Label>
        <TextField layoutX="112.0" layoutY="145.0" prefWidth="149" promptText="Digite o CPF do Cliente">
            <font>
                <Font name="PricedownBl-Regular" size="12" />
            </font>
        </TextField>
        <Label layoutX="13.0" layoutY="197.0" text="Celular" textFill="WHITE">
            <font>
                <Font name="PricedownBl-Regular" size="18" />
            </font>
        </Label>
        <TextField layoutX="112.0" layoutY="197.0" prefWidth="149" promptText="Digite o Celular do Cliente">
            <font>
                <Font name="PricedownBl-Regular" size="12" />
            </font>
        </TextField>
      <Label layoutX="20.0" layoutY="249.0" text="E-MAIL" textFill="WHITE">
         <font>
            <Font name="PricedownBl-Regular" size="18" />
         </font>
      </Label>
      <TextField layoutX="112.0" layoutY="249.0" prefWidth="149" promptText="Digite o E-MAIL do Cliente">
         <font>
            <Font name="PricedownBl-Regular" size="12" />
         </font>
      </TextField>
      <Label layoutX="23.0" layoutY="299.0" text="ENDEREÇO" textFill="WHITE">
         <font>
            <Font name="PricedownBl-Regular" size="18" />
         </font>
      </Label>
      <TextField layoutX="112.0" layoutY="299.0" prefWidth="149" promptText="Digite o Endereço do Cliente">
         <font>
            <Font name="PricedownBl-Regular" size="12" />
         </font>
      </TextField>
      <Label layoutX="215.0" layoutY="42.0" text="Cadastro de Clientes" textFill="WHITE">
         <font>
            <Font name="PricedownBl-Regular" size="18" />
         </font>
      </Label>
        <TableView fx:id="tabelaClientes" layoutX="356.0" layoutY="100.0" prefHeight="260" prefWidth="230" styleClass="clientes-table">
            <columns>
                <TableColumn fx:id="colNome" text="Nome" />
                <TableColumn fx:id="colCpf" text="CPF" />
                <TableColumn fx:id="colCelular" text="Celular" />
                <TableColumn fx:id="colEmail" text="E-mail" />
            </columns>
        </TableView>
    </AnchorPane>
</StackPane>
