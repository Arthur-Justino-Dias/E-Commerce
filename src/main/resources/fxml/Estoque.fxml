<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefWidth="600" prefHeight="400" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ecommerce.Controller.ProdutosController">

    <Label layoutX="200" layoutY="30" text="PRODUTOS" textFill="WHITE">
        <font>
            <Font name="PricedownBl-Regular" size="28"/>
        </font>
    </Label>
    <Label layoutX="80" layoutY="100" text="NOME" textFill="WHITE">
        <font>
            <Font name="PricedownBl-Regular" size="18"/>
        </font>
    </Label>
    <TextField layoutX="200" layoutY="98" prefWidth="220" promptText="Digite o nome do produto">
        <font>
            <Font name="PricedownBl-Regular" size="12"/>
        </font>
    </TextField>
    <Label layoutX="80" layoutY="160" text="PREÇO" textFill="WHITE">
        <font>
            <Font name="PricedownBl-Regular" size="18"/>
        </font>
    </Label>
    <TextField layoutX="200" layoutY="158" prefWidth="120" promptText="R$ 0,00">
        <font>
            <Font name="PricedownBl-Regular" size="12"/>
        </font>
    </TextField>
    <Button layoutX="200" layoutY="230" text="SALVAR">
        <font>
            <Font name="PricedownBl-Regular" size="14"/>
        </font>
    </Button>

</AnchorPane>